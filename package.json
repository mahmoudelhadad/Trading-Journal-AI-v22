{
  "name": "trading-journal-ai",
  "version": "1.4.0",
  "private": true,
  "description": "Professional AI-Powered Trading Journal",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
